---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<BaseLayout>
  <header class="site-header">
    <nav class="nav-wrap" aria-label="Primary navigation">
      <a class="brand" href="/">Nagato <span>Yukii</span></a>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#notes">Notes</a></li>
        <li><a href="#links">Links</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-wrap">
    <section id="about" class="profile" aria-labelledby="profile-name">
      <img
        class="avatar"
        src={site.avatar}
        alt={`${site.name}'s GitHub profile picture`}
        width="224"
        height="224"
      />
      <div class="profile-copy">
        <p class="eyebrow">Hello, I’m</p>
        <h1 id="profile-name">{site.name}</h1>
        <p class="role">{site.role} · {site.location}</p>
        <p class="bio">{site.intro}</p>
        <p class="bio">{site.note}</p>
        <ul class="interest-list" aria-label="Areas of interest">
          {site.interests.map((interest) => <li>{interest}</li>)}
        </ul>
        <div class="social-row" aria-label="Social profiles">
          {site.links.map((link) =>
            link.href ? (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}<span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="social-placeholder" title={link.display}>{link.label}</span>
            ),
          )}
        </div>
      </div>
    </section>

    <section id="notes" class="section-block" aria-labelledby="notes-heading">
      <div class="section-heading">
        <h2 id="notes-heading">Recent Notes</h2>
        <p>Writing, experiments, and work in progress.</p>
      </div>
      <ol class="note-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.summary}</p>
              {post.data.tags.length > 0 && (
                <ul class="tag-list" aria-label="Tags">
                  {post.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="links" class="section-block" aria-labelledby="links-heading">
      <div class="section-heading">
        <h2 id="links-heading">Around the Web</h2>
        <p>Profiles and places where you can find me.</p>
      </div>
      <ul class="link-cards">
        {site.links.map((link) => (
          <li>
            <span>{link.label}</span>
            {link.href ? (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.display}<span aria-hidden="true"> ↗</span>
              </a>
            ) : (
              <em>{link.display}</em>
            )}
          </li>
        ))}
      </ul>
    </section>

    <footer class="footer">
      <p>© {new Date().getUTCFullYear()} {site.name}</p>
      <p>Built with Astro · Hosted on GitHub Pages</p>
    </footer>
  </div>
</BaseLayout>

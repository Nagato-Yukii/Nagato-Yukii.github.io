---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const formatDate = (date: Date, precision: "day" | "month") =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    ...(precision === "day" ? { day: "numeric" as const } : {}),
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<BaseLayout>
  <header class="site-header">
    <nav class="nav-wrap" aria-label="Primary navigation">
      <a class="brand" href="/">Kaixuan <span>Chen</span></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <ul id="nav-links" class="nav-links">
        <li><a href="#notes">Notes</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#publications">Publications</a></li>
        <li><a href="#games">Games</a></li>
        <li><a href="#more">More</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-wrap">
    <section id="about" class="profile" aria-labelledby="profile-name">
      <img
        class="avatar"
        src={site.avatar}
        alt={`${site.name}'s GitHub profile picture`}
        width="224"
        height="224"
      />
      <div class="profile-copy">
        <h1 id="profile-name">{site.name}</h1>
        <p class="role">{site.role} · {site.location}</p>
        <p class="bio">{site.intro}</p>
        <ul class="interest-list" aria-label="Areas of interest">
          {site.interests.map((interest) => <li>{interest}</li>)}
        </ul>
        <div class="social-row" aria-label="Social profiles">
          {site.links.map((link) =>
            link.href ? (
              <a href={link.href} target="_blank" rel="noreferrer">
                <span class={`social-icon social-icon-${link.icon}`} aria-hidden="true">
                  {link.icon === "github" && (
                    <svg viewBox="0 0 24 24" role="img">
                      <path fill="currentColor" d="M12 .7a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.6-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.22.7.82.58A12 12 0 0 0 12 .7Z" />
                    </svg>
                  )}
                  {link.icon === "zhihu" && <span>知</span>}
                  {link.icon === "google" && (
                    <svg viewBox="0 0 18 18" role="img">
                      <path fill="#4285f4" d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.482h4.844a4.14 4.14 0 0 1-1.797 2.716v2.258h2.909c1.702-1.567 2.684-3.874 2.684-6.615Z" />
                      <path fill="#34a853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.909-2.258c-.806.54-1.835.859-3.047.859-2.344 0-4.328-1.585-5.037-3.714H.956v2.332A9 9 0 0 0 9 18Z" />
                      <path fill="#fbbc05" d="M3.963 10.707A5.42 5.42 0 0 1 3.681 9c0-.592.102-1.167.282-1.707V4.961H.956A9 9 0 0 0 0 9c0 1.453.348 2.827.956 4.039l3.007-2.332Z" />
                      <path fill="#ea4335" d="M9 3.579c1.321 0 2.507.454 3.441 1.345l2.581-2.581C13.463.891 11.426 0 9 0A9 9 0 0 0 .956 4.961l3.007 2.332C4.672 5.164 6.656 3.579 9 3.579Z" />
                    </svg>
                  )}
                  {link.icon === "bilibili" && (
                    <svg viewBox="0 0 24 24" role="img" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m8 3 2.5 3M16 3l-2.5 3" />
                      <rect x="2.5" y="6.5" width="19" height="14" rx="3" />
                      <path d="M8.5 12v3M15.5 12v3" />
                    </svg>
                  )}
                </span>
                <span>{link.label}</span>
              </a>
            ) : (
              <span class="social-placeholder" title={link.display}>{link.label}</span>
            ),
          )}
        </div>
      </div>
    </section>

    <section id="notes" class="section-block" aria-labelledby="notes-heading">
      <div class="section-heading">
        <h2 id="notes-heading">Recent Notes</h2>
      </div>
      <ol class="note-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, post.data.datePrecision)}</time>
            <div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.summary}</p>
              {post.data.tags.length > 0 && (
                <ul class="tag-list" aria-label="Tags">
                  {post.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="projects" class="section-block" aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">Latest Projects</h2>
      </div>
      <div class="projects-grid">
        {site.projects.map((project, index) => (
          <article class="project-card">
            <a class="project-media" href={project.href} target="_blank" rel="noreferrer" tabindex="-1" aria-hidden="true">
              <img src={project.image} alt="" width="1200" height="600" loading="lazy" />
            </a>
            <div class="project-body">
              <span class="project-number" aria-hidden="true">0{index + 1}</span>
              <h3><a href={project.href} target="_blank" rel="noreferrer">{project.title}</a></h3>
              <p>{project.description}</p>
              <ul class="tag-list" aria-label="Project tags">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="publications" class="section-block" aria-labelledby="publications-heading">
      <div class="section-heading">
        <h2 id="publications-heading">Publications</h2>
      </div>
      <ol class="publication-list">
        {site.publications.map((publication) => (
          <li>
            <img
              src={publication.image}
              alt={publication.imageAlt}
              width="502"
              height="383"
              loading="lazy"
            />
            <div class="publication-copy">
              <h3>{publication.title}</h3>
              <p>{publication.authors}</p>
              <div class="publication-meta">
                <span>{publication.venue}</span>
                <div class="publication-actions">
                  <a href={publication.pdf} target="_blank" rel="noreferrer" aria-label={`PDF: ${publication.title}`}>PDF</a>
                  {publication.code && (
                    <a href={publication.code} target="_blank" rel="noreferrer" aria-label={`Code: ${publication.title}`}>Code</a>
                  )}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="games" class="section-block" aria-labelledby="games-heading">
      <div class="section-heading">
        <h2 id="games-heading">Games Played</h2>
      </div>
      <div class="game-list">
        {site.games.map((game) => (
          <article class="game-card">
            <img src={game.image} alt={`A scene from ${game.title}`} width="560" height="315" loading="lazy" />
            <div class="game-copy">
              <div>
                <h3>{game.title}</h3>
                <p>{game.subtitle}</p>
              </div>
              <time>Finished · {game.finished}</time>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="more" class="section-block" aria-labelledby="more-heading">
      <div class="section-heading">
        <h2 id="more-heading">More</h2>
      </div>
      <div class="more-grid">
        <div>
          <h3>About this site</h3>
          <p>A personal archive for robotics projects, papers, games, and notes.</p>
        </div>
        <div>
          <h3>Still to come</h3>
          <p>Contact details, a CV, awards, or anything else that does not fit above.</p>
        </div>
      </div>
    </section>

    <footer class="footer">
      <p>© {new Date().getUTCFullYear()} {site.name} · Built with care</p>
    </footer>
  </div>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const links = document.querySelector<HTMLElement>("#nav-links");

    toggle?.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      toggle.classList.toggle("is-open", !open);
      links?.classList.toggle("is-open", !open);
    });

    links?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.classList.remove("is-open");
        links.classList.remove("is-open");
      });
    });
  </script>
</BaseLayout>

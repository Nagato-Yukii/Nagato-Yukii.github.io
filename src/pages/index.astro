---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const activeLinks = site.links.filter((link) => link.href);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<BaseLayout>
  <header class="site-header">
    <nav class="nav-wrap" aria-label="Primary navigation">
      <a class="brand" href="/">Nagato <span>Yukii</span></a>
      <ul>
        <li><a href="#notes">Notes</a></li>
        <li><a href="https://github.com/Nagato-Yukii" target="_blank" rel="noreferrer">GitHub</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-wrap">
    <section id="about" class="profile" aria-labelledby="profile-name">
      <img
        class="avatar"
        src={site.avatar}
        alt={`${site.name}'s GitHub profile picture`}
        width="224"
        height="224"
      />
      <div class="profile-copy">
        <h1 id="profile-name">{site.name}</h1>
        <p class="role">{site.role} · {site.location}</p>
        <p class="bio">{site.intro}</p>
        <ul class="interest-list" aria-label="Areas of interest">
          {site.interests.map((interest) => <li>{interest}</li>)}
        </ul>
        <div class="social-row" aria-label="Social profiles">
          {activeLinks.map((link) => (
            <a href={link.href!} target="_blank" rel="noreferrer">
              {link.label}<span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="notes" class="section-block" aria-labelledby="notes-heading">
      <div class="section-heading">
        <h2 id="notes-heading">Recent Notes</h2>
      </div>
      <ol class="note-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.summary}</p>
              {post.data.tags.length > 0 && (
                <ul class="tag-list" aria-label="Tags">
                  {post.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="footer">
      <p>© {new Date().getUTCFullYear()} {site.name} · Built with care</p>
    </footer>
  </div>
</BaseLayout>

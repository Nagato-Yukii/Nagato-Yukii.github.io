---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<BaseLayout>
  <header class="masthead">
    <p class="prompt" aria-label="Terminal prompt">
      <span class="prompt-user">{site.handle}@github-pages</span><span>:</span><span class="prompt-path">~</span><span>$</span><span class="cursor" aria-hidden="true"></span>
    </p>
    <h1>{site.name}</h1>
    <p class="intro">{site.intro}</p>
    <p class="system-line">[ static / independent / under construction ]</p>
  </header>

  <section class="directory" aria-labelledby="links-heading">
    <div class="command-row">
      <h2 id="links-heading">$ ls ./links</h2>
      <span>{site.links.length} entries</span>
    </div>
    <ul class="link-list" role="list">
      {site.links.map((link) => (
        <li>
          <span class="permission" aria-hidden="true">-rw-r--r--</span>
          <span class="link-label">{link.label.padEnd(11, ".")}</span>
          {link.href ? (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.display}<span class="external-mark" aria-hidden="true"> ↗</span>
            </a>
          ) : (
            <span class="placeholder">&lt;{link.display}&gt;</span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="posts" aria-labelledby="posts-heading">
    <div class="command-row">
      <h2 id="posts-heading">$ find ./notes -type f</h2>
      <span>{posts.length} files</span>
    </div>

    <ol class="post-list">
      {posts.map((post) => (
        <li class="post-entry">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <div class="post-copy">
            <p class="file-path">./notes/{post.id}.md</p>
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.summary}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list" aria-label="Tags">
                {post.data.tags.map((tag) => <li>#{tag}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <footer class="footer">
    <p><span aria-hidden="true">//</span> plain text, small files, no tracking.</p>
    <a href="#content">[ return to top ]</a>
  </footer>
</BaseLayout>

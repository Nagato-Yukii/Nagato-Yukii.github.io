---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404" description="The requested file does not exist.">
  <section class="not-found">
    <p class="prompt"><span class="prompt-user">guest@github-pages</span>:<span class="prompt-path">~</span>$ cat requested-file</p>
    <p class="error-line">cat: requested-file: No such file or directory</p>
    <h1>404</h1>
    <p>The path you requested is not in this directory.</p>
    <a href="/">&lt;- return to /home</a>
  </section>
</BaseLayout>

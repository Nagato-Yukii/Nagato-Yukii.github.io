---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="404" description="The requested file does not exist.">
  <header class="site-header">
    <nav class="nav-wrap" aria-label="Primary navigation">
      <a class="brand" href="/">Nagato <span>Yukii</span></a>
      <a class="back-link" href="/">← Home</a>
    </nav>
  </header>
  <section class="not-found page-wrap">
    <p class="eyebrow">Page not found</p>
    <h1>404</h1>
    <p>The page you requested is not here, or it may have moved.</p>
    <a class="primary-link" href="/">Return to {site.name}</a>
  </section>
</BaseLayout>
